<%- include("../../partials/header") %>
<main class="max-w-md mx-auto px-4 py-6">
  <h1 class="text-xl font-semibold mb-4"><%= league ? "Editar liga" : "Nueva liga" %></h1>
  <% if (sports.length === 0) { %>
    <p class="text-sm text-amber-400">Primero tenés que cargar al menos un <a href="/panel/sports/new" class="underline">deporte</a>.</p>
  <% } else { %>
    <form method="POST" action="<%= league ? `/panel/leagues/${league.id}` : '/panel/leagues' %>" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div>
        <label class="block text-sm mb-1">Nombre</label>
        <input name="name" required value="<%= league ? league.name : '' %>"
          class="w-full rounded bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-sm mb-1">Deporte</label>
        <select name="sportId" required class="w-full rounded bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm">
          <% sports.forEach(s => { %>
            <option value="<%= s.id %>" <%= league && league.sportId === s.id ? "selected" : "" %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-sm mb-1">Slug (opcional)</label>
        <input name="slug" value="<%= league ? league.slug : '' %>" placeholder="ej: liga-nacional"
          class="w-full rounded bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm" />
      </div>
      <button class="rounded bg-blue-600 hover:bg-blue-500 px-4 py-2 text-sm">Guardar</button>
    </form>
  <% } %>
</main>
<%- include("../../partials/footer") %>
