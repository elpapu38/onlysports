<%- include("../../partials/header") %>
<main class="max-w-md mx-auto px-4 py-6">
  <h1 class="text-xl font-semibold mb-4"><%= season ? "Editar temporada" : "Nueva temporada" %></h1>
  <% if (leagues.length === 0) { %>
    <p class="text-sm text-amber-400">Primero tenés que cargar al menos una <a href="/panel/leagues/new" class="underline">liga</a>.</p>
  <% } else { %>
    <form method="POST" action="<%= season ? `/panel/seasons/${season.id}` : '/panel/seasons' %>" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div>
        <label class="block text-sm mb-1">Nombre</label>
        <input name="name" required value="<%= season ? season.name : '' %>" placeholder="ej: Apertura 2026"
          class="w-full rounded bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-sm mb-1">Año</label>
        <input name="year" type="number" required value="<%= season ? season.year : new Date().getFullYear() %>"
          class="w-full rounded bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-sm mb-1">Liga</label>
        <select name="leagueId" required class="w-full rounded bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm">
          <% leagues.forEach(l => { %>
            <option value="<%= l.id %>" <%= season && season.leagueId === l.id ? "selected" : "" %>><%= l.name %></option>
          <% }) %>
        </select>
      </div>
      <button class="rounded bg-blue-600 hover:bg-blue-500 px-4 py-2 text-sm">Guardar</button>
    </form>
  <% } %>
</main>
<%- include("../../partials/footer") %>
