<%- include("../../partials/header") %>
<main class="max-w-md mx-auto px-4 py-6">
  <h1 class="text-xl font-semibold mb-4"><%= sport ? "Editar deporte" : "Nuevo deporte" %></h1>
  <form method="POST" action="<%= sport ? `/panel/sports/${sport.id}` : '/panel/sports' %>" class="space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div>
      <label class="block text-sm mb-1">Nombre</label>
      <input name="name" required value="<%= sport ? sport.name : '' %>"
        class="w-full rounded bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="block text-sm mb-1">Slug (opcional, se genera solo si lo dejás vacío)</label>
      <input name="slug" value="<%= sport ? sport.slug : '' %>" placeholder="ej: futbol"
        class="w-full rounded bg-neutral-900 border border-neutral-800 px-3 py-2 text-sm" />
    </div>
    <button class="rounded bg-blue-600 hover:bg-blue-500 px-4 py-2 text-sm">Guardar</button>
  </form>
</main>
<%- include("../../partials/footer") %>
