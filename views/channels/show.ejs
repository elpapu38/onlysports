<%- include("../partials/header") %>
<main class="max-w-6xl mx-auto px-4 py-6 space-y-4">
  <div>
    <p class="text-xs text-neutral-500 uppercase tracking-wide"><%= channel.type %></p>
    <h1 class="text-xl font-semibold"><%= channel.name %></h1>
    <% if (channel.sport || channel.league) { %>
      <p class="text-sm text-neutral-400">
        <%= channel.sport ? channel.sport.name : "" %>
        <% if (channel.league) { %>· <%= channel.league.name %><% } %>
      </p>
    <% } %>
  </div>

  <div class="rounded-lg overflow-hidden border border-neutral-800 bg-black aspect-video">
    <% if (embed.kind === "youtube") { %>
      <iframe class="w-full h-full" src="<%= embed.embedUrl %>" title="<%= channel.name %>"
        referrerpolicy="strict-origin-when-cross-origin"
        allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
    <% } else if (embed.kind === "twitch") { %>
      <iframe class="w-full h-full" src="<%= embed.embedUrl %>" title="<%= channel.name %>" allowfullscreen></iframe>
    <% } else if (embed.kind === "vimeo") { %>
      <iframe class="w-full h-full" src="<%= embed.embedUrl %>" title="<%= channel.name %>"
        referrerpolicy="strict-origin-when-cross-origin"
        allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
    <% } else if (embed.kind === "hls") { %>
      <video id="hls-player" class="w-full h-full" controls></video>
    <% } else if (embed.kind === "video") { %>
      <video class="w-full h-full" controls src="<%= embed.streamUrl %>"></video>
    <% } else { %>
      <div class="w-full h-full flex items-center justify-center text-neutral-500 text-sm p-6 text-center">
        No podemos mostrar este enlace acá adentro.
        <a class="text-blue-400 underline ml-1" href="<%= channel.value %>" target="_blank" rel="noopener">Abrirlo en el navegador</a>.
      </div>
    <% } %>
  </div>

  <% if (channel.notes) { %>
    <p class="text-sm text-neutral-400 border border-neutral-800 rounded p-3"><%= channel.notes %></p>
  <% } %>

  <a href="<%= channel.value %>" target="_blank" rel="noopener" class="text-xs text-neutral-500 hover:text-neutral-300 underline">
    Abrir el enlace original en el navegador
  </a>
</main>

<% if (embed.kind === "hls") { %>
  <script src="https://cdn.jsdelivr.net/npm/hls.js@1/dist/hls.min.js"></script>
  <script src="/js/hls-player.js" data-src="<%= embed.streamUrl %>"></script>
<% } %>
<%- include("../partials/footer") %>
