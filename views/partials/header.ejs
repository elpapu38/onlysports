<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== "undefined" ? title : appName %> · <%= appName %></title>
  <link rel="stylesheet" href="/css/app.css" />
  <link rel="icon" href="/icons/favicon.svg" />
  <meta name="csrf-token" content="<%= csrfToken %>" />
</head>
<body class="bg-neutral-950 text-neutral-100 min-h-screen flex flex-col">
<header class="border-b border-neutral-800 bg-neutral-950 sticky top-0 z-10" style="-webkit-app-region: drag;">
  <nav class="max-w-6xl mx-auto pl-3 pr-36 py-2.5 flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <button type="button" id="nav-back" title="Volver" aria-label="Volver"
        class="text-neutral-400 hover:text-white text-lg leading-none px-1" style="-webkit-app-region: no-drag;">
        ←
      </button>
      <a href="/" class="font-bold text-lg tracking-tight" style="-webkit-app-region: no-drag;">
        🏆 <%= appName %>
      </a>
    </div>
    <div class="flex items-center gap-4 text-sm" style="-webkit-app-region: no-drag;">
      <a href="/en-vivo" class="hover:text-red-400">🔴 En vivo</a>
      <a href="/resultados" class="hover:text-neutral-300">Resultados</a>
      <a href="/posiciones" class="hover:text-neutral-300">Posiciones</a>
      <a href="/channels" class="hover:text-neutral-300">Canales</a>
      <a href="/panel" class="hover:text-neutral-300">Gestión</a>
      <a href="/settings/backup" class="hover:text-neutral-300">Backup</a>
    </div>
  </nav>
</header>
<script src="/js/nav-back.js"></script>
