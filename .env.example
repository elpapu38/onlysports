# ── App ─────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=OnlySports
SESSION_SECRET=change-me-please
CSRF_SECRET=change-me-too

# ── Base de datos (SQLite: un solo archivo, sin servidor) ──
# Para la app de escritorio (Electron) no hace falta tocar esto: se
# arma solo en tiempo de ejecución. Esto es solo para `npm run dev`
# (modo navegador/desarrollo).
DATABASE_URL="file:./prisma/dev.db"

# ── Redis (opcional; no se usa en la app de escritorio) ─────
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED=false

# ── Providers deportivos ─────────────────────
# TheSportsDB: "123" es la key pública gratuita (30 pedidos/min),
# ya viene configurada por defecto, no hace falta tocarla para
# empezar. Si en algún momento pasás a Premium (thesportsdb.com/pricing),
# poné tu key acá.
THESPORTSDB_API_KEY=123

# Estos son para providers que todavía son esqueletos (ver README) —
# no hace falta completarlos para que la app funcione.
NBA_PROVIDER_API_KEY=
MLB_PROVIDER_API_KEY=
FOOTBALL_PROVIDER_API_KEY=
LIGA_NACIONAL_PROVIDER_API_KEY=

# ── Sincronización ──────────────────────────
SYNC_UPCOMING_CRON="0 */6 * * *"
SYNC_TODAY_CRON="*/10 * * * *"
SYNC_LIVE_CRON="*/1 * * * *"
SYNC_HISTORICAL_CRON="0 3 * * *"

# ── Admin panel (uso personal) ──────────────
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
